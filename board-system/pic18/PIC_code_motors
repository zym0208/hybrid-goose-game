// FUNCTION: DATA EXTRACTION AND PROCESSING
void extract_data(uint8_t byte1, uint8_t byte2) {
    // Combine 2 bytes into 16-bit data
    uint16_t data = (byte1 << 8) | byte2;
    
    // Extract all fields according to protocol
    temp_pos_X = (data >> 11) & 0x1F;       // bits 15-11 (0-31)
    temp_pos_Y = (data >> 6) & 0x1F;        // bits 10-6 (0-31)
    uint8_t place_bit = (data >> 5) & 0x01; // bit 5
    ID = (data >> 4) & 0x01;                // bit 4
    uint8_t request = (data >> 3) & 0x01;   // bit 3
    
    // Store place_bit in correct variable
    if (ID == 0) {
        placeX = place_bit;
    } else {
        placeY = place_bit;
    }
    
    // If request bit is set, echo the message back
    if (request == 1) {
        // Construct response (exactly the same data)
        uint16_t response_data = (temp_pos_X << 11)
                               | (temp_pos_Y << 6)
                               | (place_bit << 5)
                               | (ID << 4)
                               | (request << 3);
        
        uint8_t response_byte1 = (response_data >> 8) & 0xFF;
        uint8_t response_byte2 = response_data & 0xFF;
        
        // Send via NRF
        send_bytes_via_nrf(response_byte1, response_byte2);
    }
    else {
        // ACK
        // Always send an ACK after processing
        // Format: 00000000000I100 (where I = ID bit)
        uint16_t ack_data = (ID << 3) | 0b100;
        uint8_t ack_byte1 = (ack_data >> 8) & 0xFF;  // Will always be 0x00
        uint8_t ack_byte2 = ack_data & 0xFF;         // Contains ID and "100"
        
        //Send ACK via NRF
        send_bytes_via_nrf(ack_byte1, ack_byte2);
        
        //UPDATE TARGET POSITION
        target_X = temp_pos_X;
        target_Y = temp_pos_Y;
        
        // Mark that new data has been received
        new_data_received = true;
    }
}
// TIMER0 INTERRUPT - STEP GENERATOR
void Step(void) {
    // Generate X-axis step
    if (x_axis_moving) {
        if (step_count >= 10) {
            STEP_X_LAT = 1;
            step_count = 0;
            
            // Update position depending on direction
            if (DIR_X_LAT == 1) {
                pos_X++;
            } else {
                pos_X--;
            }
            
            // Check if target is reached
            if (pos_X == target_X) {
                x_axis_moving = false;
            }
        } else {
            step_count++;
            STEP_X_LAT = 0;
        }
    }
    
