// FUNCTION: START MOVEMENT
void start_movement(void) {
    // Check if there is new data and if we're not already moving
    if (!new_data_received || movement_in_progress) {
        return;
    }
    
    movement_in_progress = true;
    new_data_received = false;
    
    // Calculate difference for X-axis
    int x_diff = target_X - pos_X;
    
    if (x_diff != 0) {
        // Set direction
        if (x_diff > 0) {
            DIR_X_LAT = 1;  // Forward (positive direction)
        } else {
            DIR_X_LAT = 0;  // Backward (negative direction)
        }
        
        // Start movement (Timer0 ISR will generate steps)
        x_axis_moving = true;
        step_count = 0;
    } else {
        // No movement needed
        movement_in_progress = false;
    }
    
